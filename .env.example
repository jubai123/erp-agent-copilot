# =============================================================================
# ERP Agent Copilot V6 -- Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
#   cp .env.example .env
# =============================================================================

# -- Application ----------------------------------------------------------
APP_NAME=erp-agent-copilot
DEBUG=false

# -- API Server -----------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# -- Database (required) --------------------------------------------------
DATABASE_URL=postgresql://copilot:copilot_dev@localhost:5432/erp_copilot

# -- Redis ----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -- LLM (required) -------------------------------------------------------
# Primary key. Set LLM_API_KEY explicitly, or the app auto-discovers keys
# from DASHSCOPE_API_KEY / DEEPSEEK_API_KEY in your system environment.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
# EMBEDDING_MODEL override — leave unset to use provider default

# -- Celery ---------------------------------------------------------------
CELERY_CONCURRENCY=4
# Port the Celery worker's /metrics scrape endpoint binds to (Prometheus
# scrapes worker:8003 in the compose stack).
WORKER_METRICS_PORT=8003

# -- API authentication ---------------------------------------------------
# Production MUST use api_key mode: every request needs a valid X-API-Key and
# identity derives from the key. header mode trusts X-Tenant-ID/X-User-ID and
# is for local development only.
AUTH_MODE=api_key
# Server-side secret keyed into API-key hashes (HMAC-SHA256). REQUIRED when
# AUTH_MODE=api_key — the app refuses to boot with an empty pepper. Set a
# strong random value (e.g. `openssl rand -hex 32`) and keep it stable across
# restarts, or stored keys stop verifying.
API_KEY_PEPPER=

# -- ERP API (cloud) ------------------------------------------------------
# Leave ERP_API_BASE_URL empty to use the in-process deterministic ERP
# simulator (default — offline, hermetic, used by tests). Set it to a real
# cloud ERP base URL to switch the worker's executor to HTTP calls (V5
# calling convention; the key is sent as the X-API-Key header).
ERP_API_BASE_URL=
ERP_API_KEY=

# -- Observability --------------------------------------------------------
OTEL_EXPORTER_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO

# -- Grafana (observability UI) -------------------------------------------
# REQUIRED: `docker compose up` aborts unless set — there is no default
# password. Generate one (e.g. `openssl rand -hex 16`) and keep it out of
# version control. Prometheus/Grafana host ports bind to 127.0.0.1 only.
GRAFANA_ADMIN_PASSWORD=
