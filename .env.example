# =============================================================================
# ERP Agent Copilot V6 -- Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
#   cp .env.example .env
# =============================================================================

# -- Application ----------------------------------------------------------
APP_NAME=erp-agent-copilot
DEBUG=false

# -- API Server -----------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# -- Database (required) --------------------------------------------------
DATABASE_URL=postgresql://copilot:copilot_dev@localhost:5432/erp_copilot

# -- Redis ----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -- LLM (required) -------------------------------------------------------
# Primary key. Set LLM_API_KEY explicitly, or the app auto-discovers keys
# from DASHSCOPE_API_KEY / DEEPSEEK_API_KEY in your system environment.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
# EMBEDDING_MODEL override — leave unset to use provider default

# -- Celery ---------------------------------------------------------------
CELERY_CONCURRENCY=4
# Port the Celery worker's /metrics scrape endpoint binds to (Prometheus
# scrapes worker:8003 in the compose stack).
WORKER_METRICS_PORT=8003

# -- API authentication ---------------------------------------------------
# Production MUST use api_key mode: every request needs a valid X-API-Key and
# identity derives from the key. header mode trusts X-Tenant-ID/X-User-ID and
# is for local development only.
AUTH_MODE=api_key
# Server-side secret keyed into API-key hashes (HMAC-SHA256). Set a strong
# random value in production and keep it stable across restarts.
API_KEY_PEPPER=

# -- Observability --------------------------------------------------------
OTEL_EXPORTER_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO
