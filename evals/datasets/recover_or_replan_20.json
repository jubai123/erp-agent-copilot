        "step_results": [{"step_id": "s1", "status": "FAILED", "error_code": "TIMEOUT", "is_retryable": true}]
      },
      "expected": {"status": "EXECUTING", "retry_count": 2, "replan_count": 0, "error_code": null, "errors_cleared": true}
    },
    {
