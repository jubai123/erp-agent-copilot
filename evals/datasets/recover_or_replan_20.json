{
  "description": "recover_or_replan 真实节点评测：20 条用例覆盖节点的全部决策分支（retry/replan/give-up 预算、写幂等安全、对账人工干预、no-op），每条 seed 直接映射 AgentState 在 recover_or_replan 输入端的快照，expected 断言终态 status/错误码/预算计数。节点硬接在生产图（graph.py），本数据集测的是生产真实恢复决策（docs/08 §2）。",
  "version": "1.0",
  "cases": [
    {
      "case_id": "rec-node-001",
      "desc": "带幂等键的写步骤歧义失败（TIMEOUT）→ 人工对账，禁止重试（云端丢弃 key）",
      "seed": {
        "status": "RETRYING",
        "retry_count": 0,
        "replan_count": 0,
        "errors": [{"code": "TIMEOUT", "message": "request timed out", "step_id": "s1"}],
        "plan": {"steps": [{"step_id": "s1", "tool_name": "createOrder", "risk_level": "WRITE", "idempotency_key": "eval-rec-node-001:s1"}]},
        "step_results": [{"step_id": "s1", "status": "FAILED", "error_code": "TIMEOUT", "is_retryable": true}]
      },
      "expected": {"status": "FAILED", "retry_count": 0, "replan_count": 0, "error_code": "WRITE_OUTCOME_AMBIGUOUS", "errors_cleared": false}
    },
    {
      "case_id": "rec-node-002",
      "desc": "预算内 retryable 读失败（retry=1）→ 重试",
      "seed": {
        "status": "RETRYING",
        "retry_count": 1,
        "replan_count": 0,
        "errors": [{"code": "TIMEOUT", "message": "request timed out", "step_id": "s1"}],
